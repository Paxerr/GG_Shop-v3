@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/cart.css" />

<section class="content-header">
    <div class="container-fluid">
        <h1>GIỎ HÀNG</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- bảng sản phẩm -->
            <div class="col-md-8">
                <div class="card cart-box">
                    <div class="card-header">
                        <h3 class="card-title">Sản phẩm</h3>
                    </div>

                    <div class="card-body p-0">
                        <table class="table table-striped cart-table">
                            <thead>
                                <tr>
                                    <th style="width:100px">Ảnh</th>
                                    <th>Sản phẩm</th>
                                    <th style="width:120px">Giá</th>
                                    <th style="width:110px">Số lượng</th>
                                    <th style="width:140px">Thành tiền</th>
                                    <th style="width:60px"></th>
                                </tr>
                            </thead>

                            <tbody id="cartBody">
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer">
                        <a href="/U_shop/Index" class="btn btn-secondary">
                            ← Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bảng thanh toán -->
            <div class="col-md-4">
                <div class="card order-summary">
                    <div class="card-header">
                        <h4 class="summary-title">THÔNG TIN ĐƠN HÀNG</h4>
                    </div>

                    <div class="card-body">

                        <div class="summary-row">
                            <span>Tạm tính:</span>
                            <span id="subTotal">0₫</span>
                        </div>

                        <div class="summary-row">
                            <span>Phí ship:</span>
                            <span id="shipFee">0₫</span>
                        </div>
                        <hr />

                        <div class="summary-total">
                            <span>Thành tiền:</span>
                            <span id="totalPrice">0₫</span>
                        </div>

                        <p class="mt-2">Bạn có thể nhập mã giảm giá ở trang thanh toán</p>
                        <a href="/Payment/Index" class="btn btn-primary btn-block mt-3">ĐẶT HÀNG</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section scripts {
    <script>

        $(document).ready(function () {

            function loadCart() {
                $.ajax({
                    url: "/Cart/GetCart",
                    type: "GET",
                    success: function (rs) {

                        let body = $("#cartBody");
                        body.empty();

                        if (!rs.success || rs.items.length === 0) {
                            body.append(`<tr><td colspan="5" class="text-center">Giỏ hàng trống</td></tr>`);
                            return;
                        }

                        rs.items.forEach(function (i) {

                            body.append(`
                            <tr>
                                <td><img src="${i.Product.Image}" class="cart-img"></td>
                                <td>${i.Product.Name}<br><small>${i.Product.Color} / ${i.Product.Size}</small></td>
                                <td>${formatMoney(i.Product.Price)}</td>

                                <td>
                                    <input type="number"
                                           class="form-control qty-input update-qty"
                                           data-id="${i.Id}"
                                           value="${i.Quantity}">
                                </td>

                                <td>${formatMoney(i.Product.Price * i.Quantity)}</td>

                                <td>
                                    <button class="btn btn-danger btn-sm delete-item" data-id="${i.Id}">
                                        Xóa
                                    </button>
                                </td>
                            </tr>
                        `);
                        });

                        $("#cartTotal").text(formatMoney(rs.total));
                    },
                    error: function () {
                        alert("Lỗi hệ thống!");
                    }
                });
            };

            loadCart();

            // Update SL
            $(document).on("change", ".update-qty", function () {
                let id = $(this).data("id");
                let qty = $(this).val();

                $.ajax({
                    url: "/Cart/UpdateQuantity",
                    type: "POST",
                    data: { id: id, qty: qty },
                    success: function () {
                        loadCart();
                    }
                });
            });

            // Xóa item
            $(document).on("click", ".delete-item", function () {
                let id = $(this).data("id");

                $.ajax({
                    url: "/Cart/DeleteItem",
                    type: "POST",
                    data: { id: id },
                    success: function () {
                        loadCart();
                    }
                });
            });

        });

        function formatMoney(num) {
            return num.toLocaleString("vi-VN") + "₫";
        }

    </script>
}
