@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
}

<div class="content-page">
    <div class="container-fluid">
        <h3>Chi tiết danh mục</h3>

        <div id="detailsContainer">
            <hr />
            <dl class="dl-horizontal">
                <dt>Tên danh mục</dt>
                <dd id="detailName">Đang tải...</dd>

                <dt>Mô tả danh mục</dt>
                <dd id="detailDescription">Đang tải...</dd>
            </dl>
        </div>

        <div class="mt-3">
            <a href="#" id="editLink" class="btn btn-primary mr-2">Sửa</a>
            <a href="/Categories/Index" class="btn btn-secondary">Quay về danh sách</a>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Lấy ID từ query string
        var urlParams = new URLSearchParams(window.location.search);
        var categoryId = urlParams.get('id');

        if (!categoryId) {
            alert("ID danh mục không hợp lệ");
            window.location.href = '/Categories/Index';
            return;
        }

        // Load dữ liệu chi tiết qua AJAX
        $.ajax({
            url: '/Categories/GetCategoryDetails',
            type: 'GET',
            data: { id: categoryId },
            dataType: 'json',
            success: function (result) {
                if (result.success === false) {
                    alert(result.message || "Không tìm thấy danh mục");
                    window.location.href = '/Categories/Index';
                } else {
                    // Cập nhật chi tiết lên view
                    $('#detailName').text(result.Name || '');
                    $('#detailDescription').text(result.Description || '(Không có mô tả)');

                    // Cập nhật link Edit
                    $('#editLink').attr('href', '/Categories/Edit?id=' + result.Id);
                }
            },
            error: function (xhr, status, error) {
                console.log('XHR Error:', xhr.responseText);
                alert("Có lỗi khi tải dữ liệu: " + error);
                window.location.href = '/Categories/Index';
            }
        });
    });
</script>
