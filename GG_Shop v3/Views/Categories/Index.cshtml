@{
    ViewBag.Title = "Danh sách các danh mục";
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
}

<div class="content-page">
    <div class="container-fluid">
        <h2>Danh mục</h2>
        <a href="/Categories/Create" class="btn btn-danger mt-2">
            Tạo danh mục
        </a>

        <!-- Thanh tìm kiếm realtime -->
        <div class="form-group mt-3 col-md-4">
            <input type="text" id="searchInput" class="form-control form-control-sm"
                   placeholder="Tìm kiếm theo chữ cái đầu tiên..." />
        </div>

        <!-- Table danh mục -->
        <table class="table" id="categoryTable">
            <thead>
                <tr>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th class="text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="3" class="text-center">Đang tải dữ liệu...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        loadCategories();

        // Tìm kiếm realtime
        $("#searchInput").on("keyup", function () {
            loadCategories($(this).val());
        });

        // Load danh sách danh mục
        function loadCategories(search = "") {
            $.ajax({
                url: '/Categories/GetCategories',
                type: 'GET',
                data: { search: search },
                dataType: 'json',
                success: function (data) {
                    var tbody = $("#categoryTable tbody");
                    tbody.empty();

                    if (data.length === 0) {
                        tbody.append('<tr><td colspan="3" class="text-center">Không tìm thấy danh mục nào.</td></tr>');
                        return;
                    }

                    $.each(data, function (i, item) {
                        var row = '<tr>' +
                            '<td>' + escapeHtml(item.Name || '') + '</td>' +
                            '<td>' + escapeHtml(item.Description || '') + '</td>' +
                            '<td class="text-right">' +
                            '<a href="/Categories/Edit?id=' + item.Id + '" class="badge badge-success mr-2" title="Sửa"><i class="fas fa-pencil-alt"></i></a> ' +
                            '<a href="/Categories/Details?id=' + item.Id + '" class="badge badge-info mr-2" title="Chi tiết"><i class="fas fa-eye"></i></a> ' +
                            '<a href="#" class="badge bg-warning deleteBtn" data-id="' + item.Id + '" title="Xóa"><i class="fas fa-trash-alt"></i></a>' +
                            '</td>' +
                            '</tr>';
                        tbody.append(row);
                    });
                },
                error: function (xhr, status, error) {
                    console.log('XHR Error:', xhr.responseText);
                    var tbody = $("#categoryTable tbody");
                    tbody.empty();
                    tbody.append('<tr><td colspan="3" class="text-center text-danger">Lỗi tải dữ liệu: ' + error + '</td></tr>');
                }
            });
        }

        // Xử lý xóa danh mục
        $(document).on("click", ".deleteBtn", function (e) {
            e.preventDefault();
            var id = $(this).data("id");
            var categoryName = $(this).closest('tr').find('td:first').text().trim();

            if (confirm("Bạn có chắc chắn muốn xóa danh mục \"" + categoryName + "\"?")) {
                var $deleteBtn = $(this);
                $deleteBtn.prop('disabled', true);

                $.ajax({
                    url: '/Categories/DeleteCategory',
                    type: 'POST',
                    data: { id: id },
                    dataType: 'json',
                    success: function (result) {
                        if (result && result.success) {
                            alert(result.message || "Xóa thành công!");
                            loadCategories($("#searchInput").val());
                        } else {
                            alert(result.message || "Xóa thất bại");
                            $deleteBtn.prop('disabled', false);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log('XHR Error:', xhr.responseText);
                        alert("Lỗi server khi xóa: " + error);
                        $deleteBtn.prop('disabled', false);
                    }
                });
            }
        });

        // Hàm escape HTML để tránh XSS
        function escapeHtml(text) {
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text ? text.replace(/[&<>"']/g, function (m) { return map[m]; }) : '';
        }
    });
</script> 