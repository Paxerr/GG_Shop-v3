@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/payment.css" />

<section class="content-header">
    <div class="container-fluid">
        <h1>THANH TOÁN</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- FORM BÊN TRÁI -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h4>Thông tin giao hàng</h4>

                        <form id="paymentForm">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <input id="FullName" name="FullName" class="form-control" placeholder="Họ và tên" />
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-8">
                                    <input id="Email" name="Email" type="email" class="form-control" placeholder="Email" />
                                </div>
                                <div class="form-group col-md-4">
                                    <input id="Phone" name="Phone" class="form-control" placeholder="Số điện thoại" />
                                </div>
                            </div>

                            <div class="form-group">
                                <input id="Address" name="Address" class="form-control" placeholder="Địa chỉ nhận hàng" />
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <input type="text" id="Province" name="Province" class="form-control" placeholder="Tỉnh/Thành phố" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <input type="text" id="District" name="District" class="form-control" placeholder="Quận/Huyện" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <input type="text" id="Ward" name="Ward" class="form-control" placeholder="Phường/Xã" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <textarea id="Note" name="Note" class="form-control" rows="4" placeholder="Ghi chú (không bắt buộc)"></textarea>
                            </div>

                            <h5>Phương thức thanh toán</h5>
                            <div class="form-group">
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="PaymentMethod" value="COD" checked /> Thanh toán khi nhận hàng (COD)
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="PaymentMethod" value="Transfer" /> Chuyển khoản
                                </label>
                            </div>

                        </form>

                    </div>
                </div>
            </div>

            <!-- SUMMARY BÊN PHẢI -->
            <div class="col-md-4">
                <div class="card order-summary">
                    <div class="card-header">
                        <h4 class="card-title">THÔNG TIN ĐƠN HÀNG</h4>
                    </div>

                    <div class="card-body">
                        <div id="CartItemsContainer"></div>

                        <div class="summary-row mt-3">
                            <span>Tạm tính</span>
                            <strong id="subTotal">0₫</strong>
                        </div>

                        <div class="summary-row">
                            <span>Phí vận chuyển</span>
                            <strong id="shipFee">30.000₫</strong>
                        </div>

                        <div class="discount-box mt-3">
                            <label>Mã giảm giá</label>
                            <div class="input-group promo-section">
                                <input id="promoCode" type="text" class="form-control promo-input" placeholder="Nhập mã giảm giá..." />
                                <div class="input-group-append">
                                    <button id="applyPromoBtn" class="btn promo-btn">Áp dụng</button>
                                </div>
                            </div>
                            <p id="promoMessage" class="mt-2" style="display:none"></p>
                        </div>

                        <hr />

                        <div class="summary-total">
                            <span>Tổng cộng</span>
                            <span id="totalPrice" class="float-right">0₫</span>
                        </div>

                        <button id="placeOrderBtn" class="btn submit-order-btn mt-3">Hoàn tất đơn hàng</button>

                    </div>

                </div>

                <a href="/Cart/Index" class="btn btn-back-cart btn-block mt-2">
                    ← Quay về giỏ hàng
                </a>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>

        $(document).ready(function () {

            function loadPaymentCart() {
                $.ajax({
                    url: "/Payment/LoadPaymentCart",
                    type: "GET",
                    success: function (rs) {

                        let body = $("#paymentBody");
                        body.empty();

                        rs.items.forEach(function (i) {
                            body.append(`
                            <tr>
                                <td>${i.Name}</td>
                                <td>${formatMoney(i.Price)}</td>
                                <td>${i.Quantity}</td>
                                <td>${formatMoney(i.Price * i.Quantity)}</td>
                            </tr>
                        `);
                        });

                        $("#paymentTotal").text(formatMoney(rs.total));
                    }
                });
            }

            loadPaymentCart();

            // Apply Promo
            $("#applyPromoBtn").click(function () {

                let code = $("#promoCode").val();

                $.ajax({
                    url: "/Payment/ApplyPromotion",
                    type: "POST",
                    data: { code: code },
                    success: function (rs) {

                        if (!rs.success) {
                            $("#promoMsg").text(rs.msg).addClass("text-danger");
                            return;
                        }

                        $("#promoMsg").text(rs.text).removeClass("text-danger").addClass("text-success");
                        $("#discountValue").text(formatMoney(rs.discount));
                    }
                });
            });
        });

        function formatMoney(num) {
            return num.toLocaleString("vi-VN") + "₫";
        }

    </script>
}
