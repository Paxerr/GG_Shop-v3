<hr />

 
@section scripts {
    <script>
$(document).ready(function () {

    // --- HÀM VẼ HTML 1 DANH MỤC + SẢN PHẨM ---
    function renderCategoryBlock(category, products) {

        let html = `
        <div class="row mb-5 category-block">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>${category.Name}</h2>
                </div>
            </div>`;

        $.each(products, function (i, item) {

            let img = item.MainImg ?? "/Content/img/no-image.jpg";
            let price = item.Price
                ? item.Price.toLocaleString("vi-VN", { style: "currency", currency: "VND" })
                : "Liên hệ";

            html += `
            <div class="col-lg-3 col-md-6 col-sm-6">
                <a href="/U_shop/Index">
                                <div class="product__item">
                        <div class="product__item__pic set-bg" data-setbg="${img}">
                        </div>
                        <div class="product__item__text">
                            <h4>${item.Name}</h4>
                            <h5>${price}</h5>
                        </div>
                    </div>
                </a>
            </div>`;
        });

        // nút xem thêm
        html += `
            <div class="col-12 text-center mt-3">
                <a href="/U_shop/Index?category=${category.Id}"
                    class="primary-btn">Xem thêm →</a>
            </div>
        </div>
        <hr />
        `;

        $("#home-category-list").append(html);

        // Gán background
        $('.set-bg').each(function () {
            var bg = $(this).data('setbg');
            $(this).css('background-image', 'url(' + bg + ')');
        });
    }

    // --- HÀM 2: LOAD SẢN PHẨM 1 DANH MỤC ---
    function loadCategoryProducts(category) {
        $.ajax({
            url: '@Url.Action("GetProductsByCategory", "Home")',
            type: 'GET',
            data: { categoryId: category.Id },
            success: function (products) {

                // Chỉ lấy 4–5 sản phẩm
                let topProducts = products.slice(0, 5);

                renderCategoryBlock(category, topProducts);
            }
        });
    }

    // --- HÀM 3: LOAD CATEGORIES ---
    $.ajax({
    url: '@Url.Action("GetCategoriesWithProducts", "Home")',
    type: 'GET',
    success: function (categories) {

        if (!categories || categories.length === 0) {
            $("#home-category-list").html("<p>Không có danh mục nào có sản phẩm.</p>");
            return;
        }
        let randomCats = categories.sort(() => 0.5 - Math.random()).slice(0, 3);

        $("#home-category-list").html("");

        randomCats.forEach(c => loadCategoryProducts(c));
    }
});


});
    </script>
}
