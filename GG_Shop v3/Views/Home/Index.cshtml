@section scripts {
    <script>
        $(document).ready(function () {

            // Hàm định dạng tiền tệ (ví dụ: 100000 thành 100.000 VNĐ)
            function formatCurrency(amount) {
                return amount.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
            }

            // Hàm tạo HTML cho Rating Stars
            function createRatingHtml(rating) {
                var html = '';
                for (var i = 1; i <= 5; i++) {
                    if (i <= rating) {
                        html += '<i class="fa fa-star"></i>'; // Sao đã tô
                    } else {
                        html += '<i class="fa fa-star-o"></i>'; // Sao rỗng
                    }
                }
                return html;
            }

            // Hàm gọi AJAX để lấy danh sách sản phẩm
            function loadProducts() {
                var container = $('#product-list-container');
                container.empty(); // Xóa nội dung cũ
                $('#initial-loading').show().appendTo(container); // Hiển thị loading spinner

                $.ajax({
                    url: '@Url.Action("GetHomeProducts", "Home")', // URL đến Controller Action
                    type: 'GET',
                    dataType: 'json',
                    success: function (products) {
                        $('#initial-loading').hide(); // Ẩn loading spinner

                        if (products && products.length > 0) {
                            var productsHtml = '';
                            $.each(products, function (index, product) {

                                // Xử lý các class label (New/Sale)
                                var labels = '';
                                if (product.IsNew) { labels += '<span class="label">New</span>'; }
                                if (product.IsSale && !product.IsNew) { labels += '<span class="label">Sale</span>'; } // Tránh trùng lặp nếu cả 2 đều true

                                // Xử lý giá
                                var priceDisplay = '';
                                if (product.PriceSale && product.PriceSale < product.Price) {
                                    // Có giá khuyến mãi
                                    priceDisplay = `<h5>${formatCurrency(product.PriceSale)} <del style="font-size: 14px; color: #999;">${formatCurrency(product.Price)}</del></h5>`;
                                } else {
                                    // Giá gốc
                                    priceDisplay = `<h5>${formatCurrency(product.Price)}</h5>`;
                                }

                                // Tạo HTML cho 1 sản phẩm
                                var productHtml = `
                                    <div class="col-lg-3 col-md-6 col-sm-6 mix ${product.CategorySlug || ''}">
                                        <div class="product__item ${product.IsSale ? 'sale' : ''}">
                                            <div class="product__item__pic set-bg" data-setbg="${product.ImageUrl}">
                                                ${labels}
                                                <ul class="product__hover">
                                                    <li><a href="#"><img src="/Content/img/icon/heart.png" alt=""></a></li>
                                                    <li><a href="#"><img src="/Content/img/icon/compare.png" alt=""> <span>So sánh</span></a></li>
                                                    <li><a href="/Product/Details/${product.Id}"><img src="/Content/img/icon/search.png" alt=""></a></li>
                                                </ul>
                                            </div>
                                            <div class="product__item__text">
                                                <h6>${product.Name}</h6>
                                                <a href="#" class="add-cart" data-id="${product.Id}">+ Thêm vào giỏ</a>
                                                <div class="rating">
                                                    ${createRatingHtml(product.Rating)}
                                                </div>
                                                ${priceDisplay}
                                            </div>
                                        </div>
                                    </div>
                                `;
                                productsHtml += productHtml;
                            });

                            container.html(productsHtml); // Chèn tất cả sản phẩm vào container

                            // *** BƯỚC QUAN TRỌNG: KÍCH HOẠT LẠI CÁC PLUGIN ***

                            // 1. Khởi tạo lại chức năng set-bg (nếu nó không hoạt động tự động)
                            $('.set-bg').each(function () {
                                var bg = $(this).data('setbg');
                                $(this).css('background-image', 'url(' + bg + ')');
                            });

                            // 2. Kích hoạt lại Mixitup (cần thiết cho chức năng filter)
                            // Nếu bạn đã khởi tạo Mixitup trong main.js, bạn cần gọi lại hàm khởi tạo hoặc làm mới nó.
                            // Ví dụ: if (window.mixitupInstance) { window.mixitupInstance.forceRefresh(); }
                            // Nếu bạn dùng thư viện Mixitup gốc:
                            if (typeof mixitup !== 'undefined') {
                                mixitup('.product__filter');
                            }

                        } else {
                            container.html('<div style="text-align: center; width: 100%; padding: 50px;">Không tìm thấy sản phẩm nào.</div>');
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#initial-loading').hide();
                        container.html('<div style="color: red; width: 100%; text-align: center; padding: 50px;">Lỗi tải sản phẩm: Không thể kết nối đến máy chủ.</div>');
                    }
                });
            }

            // Gọi hàm khi trang tải xong
            loadProducts();
        });
    </script>
}