@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewBag.Title = "Reset_Password";
}

<div class="login-wrapper">

    <h2>Đặt lại mật khẩu</h2>
    <p>Nhập mật khẩu mới cho tài khoản của bạn</p>

    <form id="resetForm">
        @Html.AntiForgeryToken()

        <input type="hidden" id="Email" name="Email" value="@Session["ResetEmail"]" />

        <!-- Ô nhập mật khẩu mới -->
        <div class="input-group" style="width: 100%; margin-bottom: 15px;">
            <input type="text"
                   id="NewPassword"
                   name="NewPassword"
                   class="form-control"
                   placeholder="Mật khẩu mới"
                   style="width: 100%; padding: 12px; border-radius: 8px;"
                   required />
        </div>

        <!-- Ô nhập xác nhận mật khẩu -->
        <div class="input-group" style="width: 100%; margin-bottom: 15px;">
            <input type="text"
                   id="ConfirmPassword"
                   name="ConfirmPassword"
                   class="form-control"
                   placeholder="Xác nhận mật khẩu"
                   style="width: 100%; padding: 12px; border-radius: 8px;"
                   required />
        </div>

        <span id="resetError" class="text-danger" style="display:block; margin-bottom:10px;"></span>

        <button id="btnReset" class="login-btn">Đặt lại mật khẩu</button>
    </form>
</div>


@section Scripts {
    <script>
        $("#resetForm").submit(function (e) {
            e.preventDefault();

            $("#resetError").text("");
            $("#btnReset").prop("disabled", true);

            $.ajax({
                url: "/Account/ResetPassword",
                method: "POST",
                data: $("#resetForm").serialize(), 
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        window.location.href = res.redirectUrl;
                    } else {
                        if (res.errors?._global) {
                            $("#resetError").text(res.errors._global[0]);
                        } else {
                            $("#resetError").text("Vui lòng kiểm tra lại thông tin.");
                        }
                    }
                },
                error: function () {
                    $("#resetError").text("Có lỗi xảy ra. Vui lòng thử lại sau.");
                },
                complete: function () {
                    $("#btnReset").prop("disabled", false);
                }
            });
        });
    </script>
}

