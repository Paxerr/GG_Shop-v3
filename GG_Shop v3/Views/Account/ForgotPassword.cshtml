@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewBag.Title = "Forgot_Password";
}

<div class="login-wrapper">

    <h2>Quên mật khẩu</h2>
    <p>Nhập email để nhận mã đặt lại mật khẩu</p>

    <form id="forgotForm">
        @Html.AntiForgeryToken()

        <div class="input-group">
            <input type="email" id="Email" name="Email" class="form-control" placeholder="Nhập email của bạn" required>
        </div>

        <span id="errorMessage" class="text-danger"></span>

        <button type="submit" id="btnSend" class="login-btn">
            Gửi mã
        </button>

    </form>
</div>

@section Scripts {
    <script>
        $("#forgotForm").submit(function (e) {
            e.preventDefault();

            $("#errorMessage").text("");
            $("#btnSend").prop("disabled", true);

            $.ajax({
                url: "/Account/ForgotPassword",
                method: "POST",
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    Email: $("#Email").val()
                },
                success: function (res) {
                    if (res.success) {
                        alert("Đã gửi mã. Hãy kiểm tra email!");
                        window.location.href = res.redirectUrl;
                    } else {
                        $("#errorMessage").text(res.message || "Có lỗi xảy ra.");
                    }
                },
                error: function () {
                    $("#errorMessage").text("Có lỗi xảy ra. Vui lòng thử lại sau.");
                },
                complete: function () {
                    $("#btnSend").prop("disabled", false);
                }
            });
        });
    </script>
}
