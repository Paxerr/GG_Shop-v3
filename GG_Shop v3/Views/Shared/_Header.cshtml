<header class="header">
    <div class="header__top">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-7">
                    <div class="header__top__left">
                        <p>Welcome to GG Fashion Shop</p>
                    </div>
                </div>
                <div class="col-lg-6 col-md-5">
                    <div class="header__top__right">

                        <div class="header__top__links">
                            @if (Session["User"] == null)
                            {
                                // 1. CHƯA ĐĂNG NHẬP: Hiển thị icon Đăng nhập
                                <a href="@Url.Action("Login", "Account")" title="Đăng nhập">
                                    <i class="fa fa-sign-in"></i> Đăng nhập
                                </a>
                            }
                            else
                            {
                                // 2. ĐÃ ĐĂNG NHẬP: Hiển thị Dropdown menu

                                // Đặt class 'dropdown' lên container chính
                                <div class="dropdown user-dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="false" title="Tài khoản cá nhân">
                                        <i class="fa fa-user-circle"></i> Tài khoản
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a class="dropdown-item" href="@Url.Action("Index", "UserProfile")">
                                            <p>Thông tin Tài khoản</p>
                                        </a>
                                        <a class="dropdown-item" href="@Url.Action("Index", "OrdersHistory")">
                                            <p>Đơn hàng</p>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                            <p>Đăng xuất</p>
                                        </a>
                                    </div>
                                </div>

                            }


                        </div>
                        @*<div class="header__top__hover"> ... *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-3">
                <div class="header__logo">
                    <a href="~/Home/Index"><img src="~/Content/img/logo.png" alt=""></a>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <nav class="header__menu mobile-menu">
                    <ul>
                        <li class=""><a href="~/Home/Index">Home</a></li>
                        <li><a href="/U_shop/Index">Shop</a></li>
                        @*<li>
                                <a href="#">Pages</a>
                                <ul class="dropdown">
                                    <li><a href="./about.html">About Us</a></li>
                                    <li><a href="./shop-details.html">Shop Details</a></li>
                                    <li><a href="./shopping-cart.html">Shopping Cart</a></li>
                                    <li><a href="./checkout.html">Check Out</a></li>
                                    <li><a href="./blog-details.html">Blog Details</a></li>
                                </ul>
                            </li>*@
                        @*<li><a href="./blog.html">Blog</a></li>*@
                        <li><a href="~/Information/Index">Về chúng tôi</a></li>
                        <li id="admin-menu-link" style="display:none;">
                            <a href="~/Orders/Index">Trang quản trị</a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="col-lg-3 col-md-3">
                <div class="header__nav__option">
                    <a href="#" class="search-switch"><img src="~/Content/img/icon/search.png" alt=""></a>
                    <a href="/Cart/Index"><img src="~/Content/img/icon/cart.png" alt=""> <span id="cart-item">0</span></a>
                </div>
            </div>
        </div>
        <div class="canvas__open"><i class="fa fa-bars"></i></div>
    </div>
</header>

<style>
    .user-dropdown {
        position: relative;
    }

        .user-dropdown .dropdown-menu {
            transform-origin: top center;
            transform: translateY(10px) scale(0.98);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .22s ease, transform .22s cubic-bezier(.2,.9,.3,1), visibility .18s;
            border-radius: 8px;
            padding: 6px 0;
            box-shadow: 0 12px 22px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.05);
            background: #fff;
            min-width: 200px;
            z-index: 1050;
        }
            .user-dropdown.show .dropdown-menu,
            .user-dropdown .dropdown-menu.show {
                transform: translateY(0) scale(1);
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

        .user-dropdown .dropdown-item {
            padding: 10px 16px;
            font-size: 14px;
            color: #222;
            transition: background .14s ease;
            border-radius: 6px;
        }

            .user-dropdown .dropdown-item:hover {
                background: rgba(0,0,0,0.05);
                color: #111;
            }

            .user-dropdown .dropdown-item p {
                margin: 0;
                color: inherit;
                line-height: 1.2;
            }

        .user-dropdown .dropdown-divider {
            background: rgba(0,0,0,0.06);
            height: 1px;
            margin: 6px 0;
            border: none;
        }
</style>

@{
    // Lấy role và userId từ Session an toàn
    string userRole = Session["User_Role"] != null ? Session["User_Role"].ToString() : "";
    var jsUserRoleJson = Json.Encode(userRole ?? "");

    string userIdStr = Session["User_Id"] != null ? Session["User_Id"].ToString() : "";
    var jsUserIdJson = Json.Encode(userIdStr ?? "");
}
    <script>
    var __currentUserRole = @Html.Raw(jsUserRoleJson);
    var __currentUserId = @Html.Raw(jsUserIdJson);
    function safeTrimLower(v) {
        return (typeof v === 'string') ? v.trim().toLowerCase() : '';
    }
    // Hiển thị admin menu nếu role là admin
        function showAdminIfNeeded() {
            try {
                var role = safeTrimLower(__currentUserRole);
                if (role === 'admin') {
                    var el = document.getElementById('admin-menu-link');
                    if (el) {
                        el.style.display = '';
                    }
                }
            } catch (e) {
                console && console.error && console.error('showAdminIfNeeded error', e);
            }
        }

        // gọi khi DOM đã sẵn sàng
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', showAdminIfNeeded);
        } else {
            showAdminIfNeeded();
        }

    $.ajax({
        url: "/Home/GetCartItem",
        type: "GET",
        success: function (res) {
            var total = 0;
            if (typeof res.total === "number") total = res.total;
            else if (typeof res.total === "string") total = parseInt(res.total) || 0;

            var tmp = document.getElementById("cart-item");
            if (tmp) tmp.innerText = total;
        },
        error: function () {
            console.error("Không thể tải số lượng giỏ hàng");
        }
    });
    </script>


