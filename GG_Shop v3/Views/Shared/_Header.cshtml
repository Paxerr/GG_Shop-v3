<header class="header">
    <div class="header__top">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-7">
                    <div class="header__top__left">
                        <p>Welcome to GG Fashion Shop</p>
                    </div>
                </div>
                <div class="col-lg-6 col-md-5">
                    <div class="header__top__right">

                        <div class="header__top__links">
                            @if (Session["User"] == null)
                            {
                                // 1. CHƯA ĐĂNG NHẬP: Hiển thị icon Đăng nhập
                                <a href="@Url.Action("Login", "Account")" title="Đăng nhập">
                                    <i class="fa fa-sign-in"></i> Đăng nhập
                                </a>
                            }
                            else
                            {
                                // 2. ĐÃ ĐĂNG NHẬP: Hiển thị Dropdown menu

                                // Đặt class 'dropdown' lên container chính
                                <div class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="false" title="Tài khoản cá nhân">
                                        <i class="fa fa-user-circle"></i> Tài khoản
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                            <p style="color : black ">Thông tin Tài khoản</p>
                                        </a>
                                        <a class="dropdown-item" href="@Url.Action("MyOrders", "Order")">
                                            <p style="color : black ">Đơn hàng</p>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                            <p style="color : black ">Đăng xuất</p>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                        @*<div class="header__top__hover"> ... *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-3">
                <div class="header__logo">
                    <a href="./index.html"><img src="~/Content/img/logo.png" alt=""></a>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <nav class="header__menu mobile-menu">
                    <ul>
                        <li class="active"><a href="./index.html">Home</a></li>
                        <li><a href="/U_shop/Index">Shop</a></li>
                        <li>
                            <a href="#">Pages</a>
                            <ul class="dropdown">
                                <li><a href="./about.html">About Us</a></li>
                                <li><a href="./shop-details.html">Shop Details</a></li>
                                <li><a href="./shopping-cart.html">Shopping Cart</a></li>
                                <li><a href="./checkout.html">Check Out</a></li>
                                <li><a href="./blog-details.html">Blog Details</a></li>
                            </ul>
                        </li>
                        <li><a href="./blog.html">Blog</a></li>
                        <li><a href="./contact.html">Contacts</a></li>
                    </ul>
                </nav>
            </div>
            <div class="col-lg-3 col-md-3">
                <div class="header__nav__option">
                    <a href="#" class="search-switch"><img src="~/Content/img/icon/search.png" alt=""></a>
                    <a href="/Cart/Index"><img src="~/Content/img/icon/cart.png" alt=""> <span>0</span></a>
                </div>
            </div>
        </div>
        <div class="canvas__open"><i class="fa fa-bars"></i></div>
    </div>
</header>