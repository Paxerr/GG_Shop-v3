@{
    ViewBag.Title = "Cảm ơn bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">

            <!-- Icon cảm ơn -->
            <div class="mb-4">
                <svg width="100" height="100" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="#28a745" stroke-width="2" />
                    <path d="M7 13l3 3 7-7" stroke="#28a745" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <!-- Câu cảm ơn -->
            <h2 class="mt-3">Cảm ơn bạn đã mua hàng!</h2>
            <p class="text-muted mt-2">
                Đơn hàng của bạn đã được ghi nhận. Chúng tôi sẽ liên hệ với bạn sớm nhất.
            </p>

            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-4">
                Quay về trang chủ
            </a>

        </div>
    </div>
</div>
