@{
    ViewBag.Title = "Create Product";
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
}

<div class="content-page">
    <div class="container-fluid add-form-list">
        <div class="row">
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <div class="header-title">
                            <h4 class="card-title">Thêm sản phẩm</h4>
                        </div>
                    </div>

                    <div class="card-body">
                        <form id="createProductForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <!-- Tên sản phẩm -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Tên sản phẩm *</label>
                                        <input type="text" id="Title" name="Title" class="form-control" required placeholder="Nhập tên sản phẩm" />
                                        <span id="TitleDupError" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>

                                <!-- Danh mục -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Danh mục *</label>
                                        <select id="Category_Id" name="Category_Id" class="form-control" required>
                                            <option value="">-- Chọn danh mục --</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Trạng thái -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Trạng thái</label>
                                        <select id="Status" name="Status" class="form-control">
                                            <option value="">-- Chọn trạng thái --</option>
                                            <option value="Đang bán">Đang bán</option>
                                            <option value="Chưa bán">Chưa bán</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Mô tả -->
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Mô tả</label>
                                        <textarea id="Description" name="Description" class="form-control" rows="4"></textarea>
                                    </div>
                                </div>

                                <!-- Ảnh -->
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Ảnh (chọn nhiều)</label>
                                        <input type="file" name="images" accept="image/*" multiple class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <hr />
                            <h5 class="mb-3 mt-4">Thuộc tính sản phẩm</h5>
                            <div class="row">
                                <!-- Màu sắc -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Màu sắc</label>
                                        <div class="form-control d-flex flex-wrap align-items-center" id="colorsInput" style="min-height:45px;">
                                            <input id="colorsText" class="border-0 flex-grow-1" placeholder="Thêm màu (ví dụ: Đen)" />
                                        </div>
                                        <small class="form-text text-muted">Nhấn Enter để thêm nhiều màu.</small>
                                    </div>
                                </div>

                                <!-- Kích cỡ -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Kích cỡ</label>
                                        <div class="form-control d-flex flex-wrap align-items-center" id="sizesInput" style="min-height:45px;">
                                            <input id="sizesText" class="border-0 flex-grow-1" placeholder="Thêm kích cỡ (ví dụ: M)" />
                                        </div>
                                        <small class="form-text text-muted">Nhấn Enter để thêm nhiều kích cỡ.</small>
                                    </div>
                                </div>
                            </div>

                            <hr />
                            <h5 class="mb-3 mt-4">Danh sách biến thể (SKU)</h5>
                            <div id="variantsWrapper">
                                <table id="variantsTable" class="table table-sm table-bordered">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Màu sắc</th>
                                            <th>Kích cỡ</th>
                                            <th>Mã sản phẩm</th>
                                            <th>Số lượng</th>
                                            <th>Giá (VNĐ)</th>
                                            <th>Xóa</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                                <div id="noVariantsNote" class="text-muted">
                                    Thêm ít nhất 1 màu và 1 kích cỡ để tạo sản phẩm.
                                </div>
                            </div>

                            <div class="text-center mt-4">
                                <button type="button" id="saveProductBtn" class="btn btn-primary mr-2">Lưu sản phẩm</button>
                                <button type="button" id="btnBack" class="btn btn-secondary">Hủy</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            //Khởi tạo dữ liệu
            const token = $('input[name="__RequestVerificationToken"]').val();
            const colors = new Set();
            const sizes = new Set();

            // Load danh mục
            $.get('/Products/GetCategories', function (data) {
                let html = '<option value="">-- Chọn danh mục --</option>';
                data.forEach(c => html += `<option value="${c.Id}">${c.Name}</option>`);
                $('#Category_Id').html(html);
            });

            // Kiểm tra trùng tên
            $('#Title').on('blur keydown', function (e) {
                if (e.type === 'blur' || e.key === 'Enter') {
                    e.preventDefault();
                    const title = $(this).val().trim();//trim() loại khoảng trắng 
                    if (!title) return;
                    $.get('/Products/CheckTitle', { title }, function (res) {
                        if (res.exists) {
                            $('#TitleDupError').text('Tên sản phẩm đã tồn tại.');
                        } else {
                            $('#TitleDupError').text('');
                        }
                    });
                }
            });

            // Thêm tag
            function addTag(container, set, value) {
                let v = value.trim();

                //  rỗng
                if (!v) return;
                //  kiểm tra màu
                if (container === '#colorsInput') {

                    // ❌ quá ngắn (chặn "Đ", cho phép "đỏ", "be")
                    if (v.length < 2) {
                        alert('Tên màu không hợp lệ');
                        return;
                    }

                    // ❌ không cho số
                    if (/\d/.test(v)) {
                        alert('Tên màu không được chứa số');
                        return;
                    }
                }
                //  ký tự không hợp lệ 
                if (!/^[a-zA-ZÀ-ỹ0-9\s]+$/.test(v)) {
                    alert('Giá trị không hợp lệ');
                    return;
                }
                //  Chuẩn hoá size
                if (container === '#sizesInput') {
                    v = v.toUpperCase();
                    const validSizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL', '36', '37', '38', '39', '40', '41', '42'];
                    if (!validSizes.includes(v)) {
                        alert('Kích cỡ không hợp lệ');
                        return;
                    }
                }
                //  trùng
                if (set.has(v)) return;

                set.add(v);

                const $tag = $(`
                    <span class="badge badge-light text-dark mr-2 mb-2 p-2">
                        ${v} <span class="ml-1" style="cursor:pointer;">×</span>
                    </span>
                `);

                $tag.find('span').on('click', function () {
                    set.delete(v);
                    $tag.remove();
                    generateVariants();
                });

                $(container).prepend($tag);
                generateVariants();
            }


            $('#colorsText')
                .keydown(function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        addTag('#colorsInput', colors, this.value);
                        this.value = '';
                    }
                })
                .blur(function () {
                    if (this.value.trim() !== '') {
                        addTag('#colorsInput', colors, this.value);
                        this.value = '';
                    }
                });

            $('#sizesText')
                .keydown(function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        addTag('#sizesInput', sizes, this.value);
                        this.value = '';
                    }
                })
                .blur(function () {
                    if (this.value.trim() !== '') {
                        addTag('#sizesInput', sizes, this.value);
                        this.value = '';
                    }
                });

            // Sinh biến thể
 
            function removeDiacritics(str) {
                if (!str) return "";

                // Thay Đ/đ trước vì Unicode không tách dấu
                str = str.replace(/Đ/g, "D").replace(/đ/g, "d");

                return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
            }

            //  Lấy chữ cái đầu mỗi từ 
            function getInitialsFromTitle(title) {
                if (!title) return "";
                let cleaned = removeDiacritics(title.trim());
                let parts = cleaned.split(/\s+/).filter(p => p.length > 0);
                return parts.map(p => p[0].toUpperCase()).join("");
            }


            function normalizeForSkuJS(text) {
                if (!text) return "";

                // Bỏ dấu tiếng Việt
                let cleaned = removeDiacritics(text).toUpperCase(); 

                // CHỈ giữ A–Z và 0–9
                cleaned = cleaned.replace(/[^A-Z0-9]/g, "");

                return cleaned;
            }


            function htmlEncode(str) {
                if (!str) return "";
                return String(str)
                    .replace(/&/g, "&amp;")
                    .replace(/"/g, "&quot;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
            }

            // HÀM SINH BIẾN THỂ + SKU TỰ ĐỘNG
            function generateVariants() {
                let tbody = $("#variantsTable tbody");
                tbody.empty();

                if (colors.length === 0 || sizes.length === 0) {
                    $("#noVariantsNote").show();
                    return;
                }
                $("#noVariantsNote").hide();

                let title = $("#Title").val() || "";
                let initials = getInitialsFromTitle(title); // ví dụ ATC

                let index = 0;
                colors.forEach(color => {
                    sizes.forEach(size => {
                        let colorNorm = normalizeForSkuJS(color);
                        let sizeNorm = normalizeForSkuJS(size);

                        let sku = `${initials}-${colorNorm}-${sizeNorm}`.toUpperCase();

                        tbody.append(`
                <tr>
                    <td><input name="skus[${index}].Color" class="form-control" value="${htmlEncode(color)}" readonly></td>
                    <td><input name="skus[${index}].Size" class="form-control" value="${htmlEncode(size)}" readonly></td>
                    <td><input name="skus[${index}].Sku" class="form-control" value="${htmlEncode(sku)}" readonly></td>
                    <td><input name="skus[${index}].Quantity" class="form-control" type="number" min="1" required></td>
                    <td><input name="skus[${index}].Price" class="form-control" type="number" min="0" required></td>
                    <td class="text-center"><button type="button" class="btn btn-danger btn-sm remove-row">×</button></td>
                </tr>
            `);

                        index++;
                    });
                });
            }

            // Tự động cập nhật SKU khi user đổi Title
            $("#Title").on("input", function () {
                if ($("#variantsTable tbody tr").length > 0) {
                    generateVariants();
                }
            });

            // Lưu sản phẩm (AJAX)
            $('#saveProductBtn').click(function () {
                if ($('#TitleDupError').text()) {
                    alert('Tên sản phẩm đã tồn tại.');
                    return;
                }

                if (colors.size === 0 || sizes.size === 0) {
                    alert('Vui lòng thêm ít nhất 1 màu và 1 kích cỡ.');
                    return;
                }

                const rows = $('#variantsTable tbody tr');
                if (rows.length === 0) {
                    alert('Sản phẩm phải có ít nhất 1 SKU.');
                    return;
                }

                // Validate từng SKU
                let valid = true;
                rows.each(function () {
                    const qty = $(this).find('input[name$=".Quantity"]').val();
                    const price = $(this).find('input[name$=".Price"]').val();

                    if (qty === '' || price === '' || Number(price) <= 0) {
                        valid = false;
                        return false;
                    }
                });

                if (!valid) {
                    alert('Vui lòng nhập đầy đủ Số lượng và Giá (> 0) cho tất cả SKU.');
                    return;
                }

                const fd = new FormData($('#createProductForm')[0]);
                fd.append('Colors', JSON.stringify(Array.from(colors)));
                fd.append('Sizes', JSON.stringify(Array.from(sizes)));
                fd.append('__RequestVerificationToken', token);

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("CreateAjax", "Products")',
                    data: fd,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            alert('Thêm sản phẩm thành công!');
                            // Redirect về trang danh sách sản phẩm
                            window.location.href = res.redirectUrl || '/Products/Index';
                        } else {
                            alert(res.message || 'Có lỗi khi thêm sản phẩm');
                        }
                    },
                    error: function (xhr) {
                        alert('Lỗi hệ thống khi thêm sản phẩm: ' + xhr.statusText);
                    }
                });
            });

    // Nút quay lại
    $('#btnBack').click(function(){
        window.location.href = '/Products/Index';
    });
});
    </script>
}
