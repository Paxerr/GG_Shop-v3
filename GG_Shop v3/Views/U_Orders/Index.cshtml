﻿

@{
    ViewBag.Title = "đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="checkout spad">
    <div class="container">
        <div class="checkout__form">
            <div class="row">
                <!-- Billing -->
                <div class="col-lg-8 col-md-6">
                    <h6 class="checkout__title">Thông Tin Thanh Toán</h6>

                    <div class="checkout__input">
                        <p>Họ Tên<span>*</span></p>
                        <input id="FullName" type="text" readonly>
                    </div>

                    <div class="checkout__input">
                        <p>Địa chỉ<span>*</span></p>
                        <input id="shipping_address" type="text" class="checkout__input__add">
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <div class="checkout__input">
                                <p>SĐT<span>*</span></p>
                                <input id="Phone" type="text" readonly>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="checkout__input">
                                <p>Email<span>*</span></p>
                                <input id="Email" type="text" readonly>
                            </div>
                        </div>
                    </div>
                    <div>
                        <a href="/Cart/Index" class="btn btn-secondary">
                            ← Quay lại giỏ hàng
                        </a>
                    </div>

                </div>

                <!-- Cart -->
                <div class="col-lg-4 col-md-6">
                    <div class="checkout__order">
                        <h4 class="order__title">Đơn hàng</h4>
                        <ul class="checkout__total__products" id="cartList"></ul>

                        <ul class="checkout__total__all">
                            <li>Mã giảm giá <span id="promotion">-</span></li>
                            <li>Ước tính <span id="subtotal">0đ</span></li>

                            <li>Số tiền giảm <span id="discount_amount">0đ</span></li>
                            <li>Tổng <span id="total">0đ</span></li>
                        </ul>
                        <div class="checkout__input__checkbox">
                            <label for="payment">
                                Thanh toán khi nhận hàng
                                <input type="radio" name="payment_method" id="payment" value="cod">
                                <span class="checkmark"></span>
                            </label>
                        </div>

                        <div class="checkout__input__checkbox">
                            <label for="paypal">
                                Trả trước
                                <input type="radio" name="payment_method" id="paypal" value="online">
                                <span class="checkmark"></span>
                            </label>
                        </div>

                        <button id="btnOrder" class="site-btn">Thanh toán</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section scripts {
    <script>
        $(document).ready(function () {
            console.log("Index checkout đã chạy");
            loadData();
        });

        function loadData() {
            $.ajax({
                url: '/U_Orders/LoadData',
                method: 'GET',
                success: function (res) {
                    $("#FullName").val(res.user.Full_Name);
                    $("#Email").val(res.user.Email);
                    $("#Phone").val(res.user.Phone_Number);


                    let html = '';
                    let total = 0;

                    $.each(res.cartItems, function (i, item) {
                        html += `
                        <li>
                            ${item.Title} (${item.Color}/${item.Size}) x ${item.Quantity}
                            <span>${item.Price * item.Quantity}đ</span>
                        </li>`;
                        total += item.Price * item.Quantity;
                    });

                    $("#cartList").html(html);
                    $("#subtotal").text(`${total}đ`);

                    let promoCode = res.promo.code;
                    let discount = parseFloat(res.promo.discount) || 0;
                    let finalTotal = total - discount;

                    $("#promotion").text(promoCode !== "" ? promoCode : "-");
                    $("#discount_amount").text(discount + "đ");

                    $("#total").text(finalTotal + "đ");
                }
            });
        }

        $("#btnOrder").click(function () {
            let payment = $("input[name=payment_method]:checked").val();
            let address = $("#shipping_address").val();

            // Kiểm tra chọn phương thức thanh toán
            if (!payment) {
                alert("Vui lòng chọn phương thức thanh toán trước");
                return;
            }

            if (!address) {
                alert("Vui lòng nhập địa chỉ giao hàng");
                return;
            }

            // Thanh toán ONLINE
            if (payment === "online") {
                $.ajax({
                    url: '/U_Orders/CreateOnlineOrder',
                    method: 'POST',
                    data: { shipping_address: address },
                    success: function (res) {
                        if (res.success) {
                            window.location.href = "/U_Orders/OnlinePayment?orderId=" + res.orderId;
                        } else {
                            alert(res.message);
                        }
                    }
                });
                return;
            }


            // Thanh toán COD
            $.ajax({
                url: '/U_Orders/PlaceOrder',
                method: 'POST',
                data: {
                    fullName: $("#FullName").val(),
                    shipping_address: $("#shipping_address").val(),
                    phone: $("#Phone").val(),
                    email: $("#Email").val(),
                },
                success: function (res) {
                    if (res.success) {
                        alert("Đặt hàng thành công");
                    } else {
                        alert(res.message);
                    }
                }
            });
        });


    </script>
}