@{
    ViewBag.Title = "Thanh toán Online";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="checkout spad">
    <div class="container">
        <h3 class="mb-4 text-center">Thanh toán QR</h3>

        <div class="text-center">
            <p><b>Tổng tiền:</b> @(ViewBag.TotalAmount ?? 0) đ</p>
        </div>

        <div class="text-center mt-4">
            <canvas id="qrCanvas" width="260" height="260"></canvas>
            <p class="mt-2">Quét mã QR để thanh toán</p>
        </div>

        <div class="text-center mt-4">
            <button id="btnConfirm" class="btn btn-success" style="padding:10px 25px;font-size:18px;">
                Tôi đã thanh toán
            </button>
        </div>

        <div class="text-center mt-3">
            <a href="@Url.Action("Index", "U_Orders")" class="btn btn-secondary" style="padding:8px 20px;font-size:16px;">
                ← Quay về trang đặt hàng
            </a>
        </div>
    </div>
</section>

@section scripts{

    <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
    <script>
$(document).ready(function () {
    var qrContent = @Html.Raw(Json.Encode(ViewBag.QRContent)); // QR content từ controller
    QRCode.toCanvas(document.getElementById('qrCanvas'), qrContent, function (error) {
        if (error) console.error("Lỗi tạo QR: ", error);
    });

    // AJAX xác nhận thanh toán
    $("#btnConfirm").click(function () {
        $.ajax({
            url: "/Payment/ConfirmPayment",
            type: "POST",
            data: { orderId: '@ViewBag.OrderId' },
            success: function (res) {
                if (res.success) {
                    alert("Cảm ơn bạn! Thanh toán thành công.");
                    window.location.href = "@Url.Action("Index", "U_Shop")";
                } else {
                    alert(res.msg);
                }
            },
            error: function () {
                alert("Lỗi hệ thống, vui lòng thử lại.");
            }
        });
    });
});
    </script>

}
