@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Về chúng tôi";
}

<style>
    .about-hero {
        background-image: url('@Url.Content("~/Content/img/hero/hero-1.jpg")');
        background-size: cover;
        background-position: center;
        padding: 80px 0;
        color: #fff;
        position: relative;
    }
    .about-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(10, 10, 10, 0.35);
    }
    .about-hero .container {
        position: relative;
        z-index: 2;
    }

    .about-values .value-card {
        border-radius: 10px;
        padding: 20px;
        transition: transform .18s ease, box-shadow .18s ease;
        background: #fff;
        box-shadow: 0 6px 18px rgba(18, 28, 45, 0.04);
        height: 100%;
    }
    .about-values .value-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(18, 28, 45, 0.06);
    }
    .team-member {
        text-align: center;
    }
    .team-member .img-box {
        width: 100%;
        height: 250px;
        overflow: hidden;
        border-radius: 10px;
        background: #f3f3f3;
    }
    .team-member .img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }
    .team-member h6 {margin-top: 10px; margin-bottom: 4px; }
    .team-member small { color: #777; }

    .timeline { position: relative; padding-left: 30px; }
    .timeline::before { content: ""; position: absolute; left: 12px; top: 0; bottom: 0; width: 2px; background: rgba(0,0,0,0.06); }
    .timeline-item { position: relative; margin-bottom: 28px; padding-left: 18px; }
    .timeline-item .dot { position: absolute; left: -2px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #ff6b6b; box-shadow: 0 0 0 4px rgba(255,107,107,0.06); }

    @@media (max-width: 767px) {
        .about-hero { padding: 40px 0; text-align: center; }
        .about-hero .col-md-5 { display: none; }
        .team-member .img-box { height: 200px; }
    }
</style>

<!-- HERO -->
<section class="about-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h6 class="text-uppercase" style="letter-spacing:1px; color: #ffd;">Giới thiệu</h6>
                <h1 style="font-weight:700; margin-top:8px;">Male Fashion — Thời trang cho phong cách thật</h1>
                <p style="max-width:720px; margin-top:18px; color: #f4f4f4;">
                    Chúng tôi tạo ra những bộ sưu tập mang tinh thần hiện đại, chắc chắn và thanh lịch. Từ
                    chất liệu đến đường nét, mỗi sản phẩm đều được trau chuốt để đồng hành cùng phong cách riêng của bạn.
                </p>
                <a href="@Url.Action("Index", "U_shop")" class="primary-btn" style="margin-top:12px; display:inline-block;">Khám phá bộ sưu tập <span class="arrow_right"></span></a>
            </div>

            <!-- Ảnh bên phải hero -->
            <div class="col-md-5 d-none d-md-block">
            </div>
        </div>
    </div>
</section>

<!-- COMPANY STORY -->
<section class="spad" aria-labelledby="company-story-heading">
    <div class="container">
        <div class="section-title">
            <h2 id="company-story-heading">Câu chuyện của chúng tôi</h2>
        </div>

        <div class="row">
            <div class="col-md-6">
                <p>
                    Bắt đầu từ một niềm đam mê thời trang và mong muốn mang lại sản phẩm chất lượng cho người tiêu dùng,
                    Male Fashion phát triển dựa trên nguyên tắc cốt lõi: <strong>chất lượng, tinh tế, và trách nhiệm</strong>.
                    Chúng tôi hợp tác cùng nhà thiết kế, nhà sản xuất uy tín để kiểm soát chặt chẽ quy trình sản xuất.
                </p>
                <p>
                    Trong mỗi bộ sưu tập, chúng tôi tập trung cân bằng giữa thẩm mỹ và tính ứng dụng — giúp bạn tự tin từ công sở
                    đến những sự kiện đặc biệt.
                </p>
            </div>
            <div class="col-md-6">
                <ul class="timeline" aria-hidden="false">
                    <li class="timeline-item">
                        <span class="dot" aria-hidden="true"></span>
                        <strong>2015</strong>
                        <div>Ra đời thương hiệu với cửa hàng đầu tiên tại Hà Nội.</div>
                    </li>
                    <li class="timeline-item">
                        <span class="dot" aria-hidden="true"></span>
                        <strong>2018</strong>
                        <div>Mở rộng sang thương mại điện tử, bắt đầu bán lẻ trực tuyến.</div>
                    </li>
                    <li class="timeline-item">
                        <span class="dot" aria-hidden="true"></span>
                        <strong>2022</strong>
                        <div>Đạt mốc 50.000 khách hàng và phát triển bộ sưu tập quốc tế.</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- VALUES -->
<section class="about-values spad" aria-labelledby="values-heading" style="background:#fbfbfb;">
    <div class="container">
        <div class="section-title">
            <h2 id="values-heading">Giá trị cốt lõi</h2>
            <p>Những giá trị dẫn dắt mọi hành động của chúng tôi.</p>
        </div>

        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="value-card">
                    <div style="font-size:28px; color:#ff6b6b;"><i class="fa fa-handshake"></i></div>
                    <h5 style="margin-top:10px;">Chất lượng</h5>
                    <p class="mb-0">Chọn lọc nguyên liệu, gia công tỉ mỉ để đem lại sản phẩm bền, đẹp.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="value-card">
                    <div style="font-size:28px; color:#4e89ff;"><i class="fa fa-user-check"></i></div>
                    <h5 style="margin-top:10px;">Khách hàng là trung tâm</h5>
                    <p class="mb-0">Lắng nghe và cải tiến để phục vụ trải nghiệm mua sắm tốt hơn.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="value-card">
                    <div style="font-size:28px; color:#2ecc71;"><i class="fa fa-leaf"></i></div>
                    <h5 style="margin-top:10px;">Trách nhiệm</h5>
                    <p class="mb-0">Hướng tới thực hành bền vững và trách nhiệm với cộng đồng.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TEAM -->
<section class="spad" aria-labelledby="team-heading">
    <div class="container">
        <div class="section-title">
            <h2 id="team-heading">Đội ngũ của chúng tôi</h2>
            <p>Những con người tạo nên thương hiệu.</p>
        </div>

        <div class="row">
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="team-member">
                    <div class="img-box">
                        <img src="@Url.Content("~/Content/img/team/member-1.jpg")" alt="Người sáng lập" />
                    </div>
                    <h6>Nguyễn Tuấn Anh</h6>
                    <small>Người sáng lập</small>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 mb-4">
                <div class="team-member">
                    <div class="img-box">
                        <img src="@Url.Content("~/Content/img/team/member-2.jpg")" alt="Giám đốc sáng tạo" />
                    </div>
                    <h6>Đinh Tiến Đạt</h6>
                    <small>Giám đốc sáng tạo</small>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 mb-4">
                <div class="team-member">
                    <div class="img-box">
                        <img src="@Url.Content("~/Content/img/team/member-3.jpg")" alt="Quản lý sản xuất" />
                    </div>
                    <h6>Nguyễn Văn Quyết</h6>
                    <small>Quản lý sản xuất</small>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 mb-4">
                <div class="team-member">
                    <div class="img-box">
                        <img src="@Url.Content("~/Content/img/team/member-4.jpg")" alt="Trợ lý vận hành" />
                    </div>
                    <h6>Nguyễn Hải Đăng</h6>
                    <small>Trợ lý vận hành</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA / CONTACT -->
<section class="spad" style="background: linear-gradient(90deg,#fff 0%, #f7fbff 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3>Muốn tìm hiểu thêm? Liên hệ với chúng tôi</h3>
                <p>Đội ngũ chăm sóc khách hàng của chúng tôi luôn sẵn sàng hỗ trợ bạn mọi ngày trong tuần.</p>
            </div>
            <div class="col-md-4 text-md-right">
                <a href="https://www.facebook.com/pax1503" class="primary-btn">Liên hệ ngay</a>
            </div>
        </div>
    </div>
</section>

<!-- FAQ (small) -->
<section class="spad">
    <div class="container">
        <div class="section-title">
            <h2>Những câu hỏi thường gặp</h2>
        </div>

        <div class="row">
            <div class="col-md-6">
                <h6>Chính sách đổi trả như thế nào?</h6>
                <p>Bạn có thể đổi trả trong vòng 14 ngày kể từ ngày nhận hàng (sản phẩm còn nguyên tem, chưa sử dụng).</p>
            </div>
            <div class="col-md-6">
                <h6>Vận chuyển áp dụng ở đâu?</h6>
                <p>Chúng tôi giao hàng toàn quốc, thời gian giao hàng thường từ 2 - 5 ngày làm việc tuỳ khu vực.</p>
            </div>
        </div>
    </div>
</section>

