@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
}
<div class="content-page">
    <div class="container-fluid">
        <form id="create_promotion" data-toggle="validator" role="form" novalidate>
            <div class="row">

                <!-- Promo Code -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mã giảm giá *</label>
                        <input type="text" class="form-control" name="Promo_Code"
                               required data-required-error="Vui lòng nhập mã giảm giá">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Description -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mô tả *</label>
                        <input type="text" class="form-control" name="Description"
                               required data-required-error="Vui lòng nhập mô tả">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Type -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Loại giảm giá *</label>
                        <select class="form-control" id="promoType" name="Type"
                                required data-required-error="Vui lòng chọn loại giảm giá">
                            <option value="">-- Chọn --</option>
                            <option value="Giảm theo %">Giảm theo %</option>
                            <option value="Giảm theo số tiền">Giảm theo số tiền</option>
                        </select>
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Discount Percentage -->
                <div class="col-md-6" id="percentGroup" style="display:none;">
                    <div class="form-group">
                        <label>Phần trăm giảm (%) *</label>
                        <input type="number" class="form-control" name="Discount_Percentage"
                               min="1" max="100"
                               data-required-error="Vui lòng nhập phần trăm giảm">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Discount Amount -->
                <div class="col-md-6" id="amountGroup" style="display:none;">
                    <div class="form-group">
                        <label>Số tiền giảm (VNĐ) *</label>
                        <input type="number" class="form-control" name="Discount_Amount"
                               min="1"
                               data-required-error="Vui lòng nhập số tiền giảm">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Start date -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ngày bắt đầu *</label>
                        <input type="date" class="form-control" name="Start_Date"
                               required data-required-error="Vui lòng chọn ngày bắt đầu">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- End date -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ngày kết thúc *</label>
                        <input type="date" class="form-control" name="End_Date"
                               required data-required-error="Vui lòng chọn ngày kết thúc">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Min order value -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Giá trị đơn hàng tối thiểu *</label>
                        <input type="number" class="form-control" name="Min_Order_Value"
                               required min="0"
                               data-required-error="Vui lòng nhập giá trị tối thiểu">
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

                <!-- Status -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Trạng thái *</label>
                        <select class="form-control" name="Status"
                                required data-required-error="Vui lòng chọn trạng thái">
                            <option value="">-- Chọn --</option>
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                        </select>
                        <div class="help-block with-errors"></div>
                    </div>
                </div>

            </div>

            <button type="submit" class="btn btn-primary mr-2">Tạo mã giảm giá</button>
            <button type="reset" class="btn btn-danger">Làm mới</button>
        </form>
    </div>
</div>

<script>
    $(function () {

         //* 1) VALIDATE NGÀY BẮT ĐẦU < NGÀY KẾT THÚC
        function validateDates() {
            let start = $("input[name='Start_Date']").val();
            let end = $("input[name='End_Date']").val();

            if (!start || !end) return true; // chưa nhập

            let d1 = new Date(start);
            let d2 = new Date(end);

            if (d1 >= d2) {
                alert("Ngày bắt đầu phải nhỏ hơn ngày kết thúc!");
                return false;
            }
            return true;
        }

        $("input[name='Start_Date'], input[name='End_Date']").on("change", validateDates);



         //* 3) VALIDATION + AJAX SUBMIT FORM
        $("#create_promotion").validator().on("submit", function (e) {
            if (e.isDefaultPrevented()) return;

            // kiểm tra ngày trước khi gửi
            if (!validateDates()) {
                e.preventDefault();
                return;
            }

            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({
                type: "POST",
                url: '@Url.Action("Insert", "Promotions")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {

                    alert(res);

                    // sau khi tạo → kiểm tra nếu hết hạn thì tự disable
                    let promo = $("input[name='Promo_Code']").val();
                    let end = $("input[name='End_Date']").val();
                    checkAndDisableIfExpired(promo, end);
                },
                error: function () {
                    alert("Lỗi hệ thống!");
                }
            });
        });



        /* ==========================
         * SHOW / HIDE Fields
         * ========================== */

        function setPercentRequired(on) {
            let $el = $("input[name='Discount_Percentage']");
            $el.prop("required", on);
            if (on) $el.attr("data-required-error", "Vui lòng nhập phần trăm giảm");
            else { $el.removeAttr("data-required-error").val(""); }
        }

        function setAmountRequired(on) {
            let $el = $("input[name='Discount_Amount']");
            $el.prop("required", on);
            if (on) $el.attr("data-required-error", "Vui lòng nhập số tiền giảm");
            else { $el.removeAttr("data-required-error").val(""); }
        }

        setPercentRequired(false);
        setAmountRequired(false);
        $("#percentGroup, #amountGroup").hide();

        $("#promoType").on("change", function () {
            let type = $(this).val();

            $("#percentGroup, #amountGroup").hide();
            setPercentRequired(false);
            setAmountRequired(false);

            if (type === "Giảm theo %") {
                $("#percentGroup").show();
                setPercentRequired(true);
            } else if (type === "Giảm theo số tiền") {
                $("#amountGroup").show();
                setAmountRequired(true);
            }
        });

    });
</script>


